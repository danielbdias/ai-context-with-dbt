# Copy to .env. `task setup` does this and replaces every placeholder with a
# random secret (APP_PASSWORD excepted). Never commit .env.

# --- Web app ---
# INTENTIONALLY INSECURE: fixed demo password, local demo only.
APP_PASSWORD=dssbr
CSRF_SECRET=change-me
IP_SALT=change-me
WEB_PORT=8000
# Failed-password rate limit: N per window (seconds) per client network.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900

# --- Postgres ---
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_APP_OWNER_PASSWORD=change-me
POSTGRES_WEB_WRITER_PASSWORD=change-me
POSTGRES_EL_READER_PASSWORD=change-me
POSTGRES_SUPERSET_META_PASSWORD=change-me

# --- Snowflake ---
# Your account identifier (orgname-accountname). Required for el, dbt and charts.
# Run `task snowflake:setup` once to create the roles and users below. Their
# passwords are random and set by that script, so they never leave this file.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=AICTX
SNOWFLAKE_EL_LOADER_PASSWORD=change-me
SNOWFLAKE_DBT_RUNNER_PASSWORD=change-me
SNOWFLAKE_MCP_READER_PASSWORD=change-me
SNOWFLAKE_CHARTS_READER_PASSWORD=change-me
# Admin credentials for `task snowflake:setup` only. Export them in the shell
# instead of storing them here.
# SNOWFLAKE_ADMIN_USER=
# SNOWFLAKE_ADMIN_PASSWORD=

# --- dbt platform (Semantic Layer) ---
# From docs/semantic-layer.md step 5. The token needs the permission sets
# "Semantic Layer Only" and "Metadata Only". Without these three, dbt-mcp starts
# but exposes no metrics tools and `task mcp:smoke` fails.
DBT_HOST=
# The account prefix when DBT_HOST looks like <prefix>.<cell>.dbt.com, for
# example DBT_HOST=abc123.us1.dbt.com and DBT_HOST_PREFIX=abc123. dbt-mcp 2.7.0
# does not infer it from DBT_HOST and otherwise queries a host that does not
# exist (semantic-layer.abc123.us1.dbt.com). Leave empty for cloud.getdbt.com.
DBT_HOST_PREFIX=
DBT_TOKEN=
DBT_PROD_ENV_ID=

# --- Dashboards ---
CHARTS_PORT=8090

# --- EL (dlt) ---
# Attempts per run and pause between them when a dlt step fails.
EL_MAX_ATTEMPTS=3
EL_RETRY_DELAY_SECONDS=5

# --- dbt ---
# `task dbt:docs` serves the docs site here (127.0.0.1 only).
DBT_DOCS_PORT=8081
# dbt-mcp server log level on stderr (INFO or DEBUG).
DBT_MCP_LOG_LEVEL=INFO
