{
  "mcpServers": {
    "dbt": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "--project-directory",
        ".",
        "--profile",
        "core",
        "--profile",
        "mcp",
        "run",
        "--rm",
        "-i",
        "--no-TTY",
        "dbt-mcp"
      ]
    }
  }
}
