# TEST-ONLY values for the isolated e2e compose project (`-p aictx-e2e`).
# The Postgres and web values are throwaway, intentionally public credentials.
# Never reuse them. Host ports differ from .env.example so e2e can run next to
# the dev stack.
#
# Snowflake is not here: the e2e suite runs against the real account, in a
# per-run database (AICTX_E2E_<id>) that it creates and drops. Its credentials
# come from the dev `.env` (loaded by `task e2e`) and from SNOWFLAKE_ADMIN_USER
# and SNOWFLAKE_ADMIN_PASSWORD in the shell.

APP_PASSWORD=dssbr
CSRF_SECRET=e2e-test-only-csrf
IP_SALT=e2e-test-only-salt
WEB_PORT=18000
# High enough that e2e failures never trip the limiter.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=900

POSTGRES_PORT=15432
POSTGRES_ADMIN_PASSWORD=e2e-test-only-pg-admin
POSTGRES_APP_OWNER_PASSWORD=e2e-test-only-pg-owner
POSTGRES_WEB_WRITER_PASSWORD=e2e-test-only-pg-writer
POSTGRES_EL_READER_PASSWORD=e2e-test-only-pg-reader

CHARTS_PORT=18090
# The charts container reads this e2e-only manifest, not the dev target/charts.
CHARTS_MANIFEST_DIR=./transform/dbt/target/e2e_charts
DBT_DOCS_PORT=18081
