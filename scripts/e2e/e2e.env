# TEST-ONLY values for the isolated e2e compose project (`-p aictx-e2e`).
# These are throwaway, intentionally public credentials. Never reuse them.
# Host ports differ from .env.example so e2e can run next to the dev stack.

APP_PASSWORD=dssbr
CSRF_SECRET=e2e-test-only-csrf
IP_SALT=e2e-test-only-salt
WEB_PORT=18000

POSTGRES_PORT=15432
POSTGRES_ADMIN_PASSWORD=e2e-test-only-pg-admin
POSTGRES_APP_OWNER_PASSWORD=e2e-test-only-pg-owner
POSTGRES_WEB_WRITER_PASSWORD=e2e-test-only-pg-writer
POSTGRES_EL_READER_PASSWORD=e2e-test-only-pg-reader
POSTGRES_SUPERSET_META_PASSWORD=e2e-test-only-pg-superset

CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_DEFAULT_PASSWORD=e2e-test-only-ch-default
CLICKHOUSE_EL_LOADER_PASSWORD=e2e-test-only-ch-el
CLICKHOUSE_DBT_RUNNER_PASSWORD=e2e-test-only-ch-dbt
CLICKHOUSE_MCP_READER_PASSWORD=e2e-test-only-ch-mcp
CLICKHOUSE_CHARTS_READER_PASSWORD=e2e-test-only-ch-charts
CLICKHOUSE_SUPERSET_READER_PASSWORD=e2e-test-only-ch-superset

CHARTS_PORT=18090
SUPERSET_PORT=18088
SUPERSET_SECRET_KEY=e2e-test-only-superset-key
SUPERSET_ADMIN_PASSWORD=e2e-test-only-superset-admin

# Per-run copy of infra/clickhouse/users.d (the image entrypoint writes the
# default-user password there, which would clobber the dev stack's copy).
E2E_CH_USERS_DIR=./scripts/e2e/.work/users.d
